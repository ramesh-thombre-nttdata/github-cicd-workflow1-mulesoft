<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>93e5e5a6-2d8d-45ce-8d33-bc0e77d45dd5</groupId>
		<artifactId>solutions-bom</artifactId>
		<version>1.0.0</version>
		<relativePath>./bom.xml</relativePath>
	</parent>

	<groupId>93e5e5a6-2d8d-45ce-8d33-bc0e77d45dd5</groupId>
	<artifactId>solutions-parent-pom</artifactId>
	<version>1.0.1</version>
	<packaging>pom</packaging>
	<name>solutions-parent-pom</name>

	<properties>
		<type>custom</type>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
				</plugin>
				<plugin>
					<groupId>org.mule.tools.maven</groupId>
					<artifactId>mule-maven-plugin</artifactId>
					<extensions>true</extensions>
					<configuration>
						<cloudhub2Deployment>
							<uri>https://anypoint.mulesoft.com</uri>
							<provider>MC</provider>
							<environment>${env.environment}</environment>
							<target>${env.target}</target>
							<muleVersion>4.4.0</muleVersion>
							<server>connected-app-credentials</server>
							<applicationName>${env.deployedEnv}-${project.artifactId}</applicationName>
							<replicas>${env.replicas}</replicas>
							<vCores>${env.cores}</vCores>
							<businessGroupId>${project.groupId}</businessGroupId>
							<deploymentSettings>
								<http>
									<inbound>
										<lastMileSecurity>true</lastMileSecurity>
									</inbound>
								</http>
							</deploymentSettings>
							<properties>
								<env>${env.deployedEnv}</env>
							</properties>
							<secureProperties>
								<encryption.key>${env.encryptionKey}</encryption.key>
							</secureProperties>
						</cloudhub2Deployment>
					</configuration>
				</plugin>
				<plugin>
					<groupId>com.mulesoft.munit.tools</groupId>
					<artifactId>munit-maven-plugin</artifactId>
					<executions>
						<execution>
							<id>test</id>
							<phase>test</phase>
							<goals>
								<goal>test</goal>
								<goal>coverage-report</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<coverage>
							<runCoverage>true</runCoverage>
							<formats>
								<format>html</format>
								<format>console</format>
							</formats>
						</coverage>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>